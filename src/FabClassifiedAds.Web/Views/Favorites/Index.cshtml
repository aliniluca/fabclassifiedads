@model List<Favorite>
@{
    ViewData["Title"] = T["Favorites"];
    ViewData["FavoriteIds"] = Model.Select(f => f.ListingId).ToHashSet();
}
<div class="container section-pad">
    <h1>♥ @T["Favorites"]</h1>
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon">💔</span>
            <h3>@T["No favorites yet"]</h3>
            <p>@T["Tap the heart on any ad to save it here."]</p>
        </div>
    }
    else
    {
        <div class="listing-grid mt-16">
            @foreach (var favorite in Model)
            {
                <partial name="_ListingCard" model="favorite.Listing" />
            }
        </div>
    }
</div>

@using FabClassifiedAds.Web.Services
<!DOCTYPE html>
<html lang="@(Translator.IsRo ? "ro" : "en")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? $"{ViewData["Title"]} — FabAds" : "FabAds")</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header class="site-header">
    <div class="container header-inner">
        <a class="logo" href="/"><span class="logo-mark">⚡</span>Fab<span class="logo-accent">Ads</span></a>

        <form class="header-search" action="/search" method="get">
            <input type="search" name="Q" placeholder="@T["Search 25,000+ ads — cars, apartments, phones…"]"
                   value="@(Context.Request.Query["Q"])" aria-label="@T["Search"]" />
            <button type="submit" class="btn-search" aria-label="@T["Search"]">🔍</button>
        </form>

        <nav class="header-nav">
            @{
                var currentPath = Context.Request.Path + Context.Request.QueryString;
            }
            <span class="lang-switch">
                <a href="/set-language?culture=ro&returnUrl=@Uri.EscapeDataString(currentPath)" class="@(Translator.IsRo ? "active" : "")">RO</a><span class="lang-sep">|</span><a href="/set-language?culture=en&returnUrl=@Uri.EscapeDataString(currentPath)" class="@(Translator.IsRo ? "" : "active")">EN</a>
            </span>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/saved-searches" class="nav-link" title="@T["Alerts"]">🔔<span class="nav-label">@T["Alerts"]</span></a>
                <a href="/favorites" class="nav-link" title="@T["Favorites"]">♥<span class="nav-label">@T["Favorites"]</span></a>
                <a href="/messages" class="nav-link" title="@T["Messages"]">💬<span class="nav-label">@T["Messages"]</span></a>
                <a href="/my-ads" class="nav-link" title="@T["My ads"]">📋<span class="nav-label">@T["My ads"]</span></a>
                <form action="/logout" method="post" class="inline-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="nav-link nav-button">@T["Sign out"]</button>
                </form>
            }
            else
            {
                <a href="/login" class="nav-link">@T["Sign in"]</a>
            }
            <a href="/post" class="btn btn-primary btn-post">+ @T["Post ad"]</a>
        </nav>
    </div>
</header>

@if (TempData["Flash"] is string flash)
{
    <div class="container"><div class="flash">@flash</div></div>
}

<main>
    @RenderBody()
</main>

<footer class="site-footer">
    <div class="container footer-grid">
        <div>
            <a class="logo" href="/"><span class="logo-mark">⚡</span>Fab<span class="logo-accent">Ads</span></a>
            <p class="footer-tagline">@T["The most complete classifieds platform. Buy, sell and discover anything — from cars to castles."]</p>
        </div>
        <div>
            <h4>@T["Marketplace"]</h4>
            <a href="/c/cars">@T["Cars"]</a>
            <a href="/c/real-estate">@T["Real Estate"]</a>
            <a href="/c/electronics-and-appliances">@T["Electronics"]</a>
            <a href="/c/jobs">@T["Jobs"]</a>
        </div>
        <div>
            <h4>@T["Account"]</h4>
            <a href="/post">@T["Post an ad"]</a>
            <a href="/favorites">@T["Favorites"]</a>
            <a href="/messages">@T["Messages"]</a>
            <a href="/my-ads">@T["My ads"]</a>
        </div>
        <div>
            <h4>@T["Built with"]</h4>
            <p class="footer-tagline">.NET 11 • ASP.NET Core MVC • EF Core • SQLite</p>
        </div>
    </div>
    <div class="container footer-bottom">© @DateTime.UtcNow.Year FabAds. @T["All rights reserved."]</div>
</footer>

<script src="~/js/site.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>

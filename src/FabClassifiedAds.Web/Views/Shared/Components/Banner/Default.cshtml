@model List<FabClassifiedAds.Web.Models.Entities.Banner>
@if (Model.Count > 0)
{
    <div class="banner-slot">
        @foreach (var b in Model)
        {
            <a href="/b/@b.Id/click" class="banner-ad" target="_blank" rel="nofollow sponsored noopener" title="@b.Title">
                <img src="@b.ImageUrl" alt="@b.Title" loading="lazy" />
                <span class="banner-tag">@T["Ad"]</span>
            </a>
        }
    </div>
}

@model Listing
@{
    var isFav = ViewData["FavoriteIds"] is HashSet<int> favs && favs.Contains(Model.Id);
    var image = Model.Images.FirstOrDefault();
}
<article class="card listing-card">
    <a href="@Model.SeoUrl()" class="card-media">
        @if (image != null)
        {
            <img src="@image.Url" alt="@Model.Title" loading="lazy" />
        }
        else
        {
            <div class="card-media-empty">📷</div>
        }
        @if (Model.IsFeatured) { <span class="badge badge-featured">★ @T["Featured"]</span> }
        @if (!string.IsNullOrEmpty(Model.VideoUrl)) { <span class="badge badge-video">🎬</span> }
        @if (Model.Status == ListingStatus.PendingReview) { <span class="badge badge-review">⏳ @T["In review"]</span> }
        else if (Model.Status == ListingStatus.Rejected) { <span class="badge badge-rejected">🚫 @T["Rejected"]</span> }
        @if (Model.Condition == ItemCondition.New) { <span class="badge badge-new">@T["New"]</span> }
    </a>
    <div class="card-body">
        <div class="card-meta">@Model.Category.Icon @T[Model.Category.Name]</div>
        <a href="@Model.SeoUrl()" class="card-title">@Model.Title</a>
        <div class="card-summary">@Model.ListingSummary()</div>
        <div class="card-price-row">
            <span class="card-price">@Model.Price()</span>
            @if (User.Identity?.IsAuthenticated == true)
            {
                <form action="/favorites/toggle/@Model.Id" method="post" class="inline-form fav-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="fav-btn @(isFav ? "is-fav" : "")" title="@T["Save to favorites"]">@(isFav ? "♥" : "♡")</button>
                </form>
            }
        </div>
        <div class="card-footer">
            <span>📍 @Model.City</span>
            <span class="trust-chip @(Model.TrustScore >= 75 ? "trust-good" : Model.TrustScore >= 40 ? "trust-warn" : "trust-bad")" title="@T["Trust score"]">🛡 @Model.TrustScore</span>
            <span>@Model.CreatedAt.TimeAgo()</span>
        </div>
    </div>
</article>

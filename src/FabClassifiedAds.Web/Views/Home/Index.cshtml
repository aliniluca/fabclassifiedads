@model HomeViewModel
@{
    ViewData["Title"] = T["Buy, sell, discover anything"];
}

<section class="hero">
    <div class="hero-bg"></div>
    <div class="container hero-inner">
        <h1 class="hero-title">@T["Find"] <span class="gradient-text">@T["anything"]</span>.<br/>@T["Sell"] <span class="gradient-text">@T["everything"]</span>.</h1>
        <p class="hero-subtitle">@T.Format("HeroSubtitle", Model.TotalActiveListings.Number(), Model.TotalCategories.Number())</p>

        <form class="hero-search" action="/search" method="get">
            <span class="hero-search-icon">🔍</span>
            <input type="search" name="Q" placeholder="@T["What are you looking for today?"]" aria-label="@T["Search"]" />
            <select name="Category" aria-label="@T["Category"]">
                <option value="">@T["All categories"]</option>
                @foreach (var cat in Model.RootCategories)
                {
                    <option value="@cat.Slug">@cat.Icon @T[cat.Name]</option>
                }
            </select>
            <button type="submit" class="btn btn-primary">@T["Search"]</button>
        </form>

        <div class="hero-quick">
            <span>@T["Trending:"]</span>
            <a href="/search?Q=BMW">BMW</a>
            <a href="/c/apartments-for-rent">@T["Apartments for rent"]</a>
            <a href="/c/iphone">iPhone 15</a>
            <a href="/c/gaming-pcs">Gaming PC</a>
            <a href="/c/e-bikes">E-bikes</a>
        </div>
    </div>
</section>

<section class="container section-pad">
    <div class="section-head">
        <h2>@T["Browse categories"]</h2>
        <p class="muted">@T["Every category has tailored filters — engine specs for cars, floor plans for homes."]</p>
    </div>
    <div class="category-grid">
        @foreach (var cat in Model.RootCategories)
        {
            <a href="/c/@cat.Slug" class="category-tile">
                <span class="category-icon">@cat.Icon</span>
                <span class="category-name">@T[cat.Name]</span>
                <span class="category-sub">@T.Format("CountSubcategories", cat.Children.Count)</span>
            </a>
        }
    </div>
</section>

@if (Model.FeaturedListings.Count > 0)
{
    <section class="featured-band">
        <div class="container section-pad">
            <div class="section-head">
                <h2>★ @T["Featured ads"]</h2>
                <a href="/search" class="see-all">@T["See all →"]</a>
            </div>
            <div class="listing-grid">
                @foreach (var listing in Model.FeaturedListings)
                {
                    <partial name="_ListingCard" model="listing" />
                }
            </div>
        </div>
    </section>
}

<section class="container section-pad">
    <div class="section-head">
        <h2>@T["Shop cars by brand"]</h2>
        <a href="/c/cars" class="see-all">@T["All cars →"]</a>
    </div>
    <div class="brand-strip">
        @foreach (var brand in Model.PopularBrands)
        {
            <a href="/c/cars?BrandId=@brand.Id" class="brand-chip">@brand.Name</a>
        }
    </div>
</section>

<section class="container section-pad">
    <div class="section-head">
        <h2>@T["Fresh on FabAds"]</h2>
        <a href="/search" class="see-all">@T["See all →"]</a>
    </div>
    <div class="listing-grid">
        @foreach (var listing in Model.LatestListings)
        {
            <partial name="_ListingCard" model="listing" />
        }
    </div>
</section>

<section class="cta-band">
    <div class="container cta-inner">
        <div>
            <h2>@T["Got something to sell?"]</h2>
            <p>@T["Post your ad in under a minute. Free, forever, with smart category-specific forms."]</p>
        </div>
        <a href="/post" class="btn btn-light">@T["+ Post your ad"]</a>
    </div>
</section>

<section class="container section-pad trust-grid">
    <div class="trust-item"><span>🛡️</span><h3>@T["Verified sellers"]</h3><p>@T["Ratings and reviews on every account, business badges for dealers."]</p></div>
    <div class="trust-item"><span>🎯</span><h3>@T["Surgical filters"]</h3><p>@T["Filter cars by engine, power, options. Homes by floor, heating, amenities."]</p></div>
    <div class="trust-item"><span>💬</span><h3>@T["Built-in chat"]</h3><p>@T["Message sellers instantly without sharing your phone number."]</p></div>
    <div class="trust-item"><span>⚡</span><h3>@T["Always fast"]</h3><p>@T["Built on .NET 11 — pages render in milliseconds, even on mobile."]</p></div>
</section>

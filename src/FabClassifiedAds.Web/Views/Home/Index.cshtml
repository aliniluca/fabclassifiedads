@model HomeViewModel
@{
    ViewData["Title"] = T["Checked classifieds from all over Romania"];
}

<section class="hero">
    <div class="container hero-inner">
        <div>
            <h1 class="hero-title">@T["Checked ads, from all over the country"]</h1>
            <p class="hero-subtitle">@T["HomeIntro"]</p>

            <form class="hero-search" action="/search" method="get" role="search">
                <label class="hero-field">
                    @Icons.Svg("search")
                    <span class="visually-hidden">@T["What are you looking for?"]</span>
                    <input type="search" name="Q" placeholder="@T["What are you looking for?"]" />
                </label>
                <label class="hero-field">
                    @Icons.Svg("pin")
                    <span class="visually-hidden">@T["City or county"]</span>
                    <input type="text" name="City" placeholder="@T["Whole country"]" autocomplete="address-level2" />
                </label>
                <button type="submit" class="btn btn-primary">@T["Search"]</button>
            </form>

            <p class="hero-seller">
                @T["Already selling on OLX or Autovit?"]
                <a href="/start">@Icons.Svg("link", "icon-sm")@T["Paste the link, we publish it here for free"]</a>
            </p>

            <div class="hero-quick">
                <span>@T["Popular searches:"]</span>
                <a href="/search?Q=BMW">BMW</a>
                <a href="/c/apartments-for-rent">@T["Apartments for rent"]</a>
                <a href="/c/iphone">iPhone</a>
                <a href="/c/e-bikes">@T["E-bikes"]</a>
            </div>
        </div>

        <aside class="sheet hero-sheet" aria-labelledby="sheetTitle">
            <div class="sheet-head">
                <h2 class="sheet-title" id="sheetTitle">@T["AiciGăsești verification"]</h2>
                <span class="sheet-ref">@T["on every ad"]</span>
            </div>
            <ul class="sheet-rows">
                <li class="sheet-row">
                    <span class="sheet-tick">@Icons.Svg("check")</span>
                    <div><strong>@T["Price checked against the market"]</strong><span>@T["Compared with the median of similar ads; suspiciously cheap gets flagged."]</span></div>
                </li>
                <li class="sheet-row">
                    <span class="sheet-tick">@Icons.Svg("check")</span>
                    <div><strong>@T["Text scanned for scam tricks"]</strong><span>@T["Advance-payment requests, outside links and pressure phrases."]</span></div>
                </li>
                <li class="sheet-row">
                    <span class="sheet-tick">@Icons.Svg("check")</span>
                    <div><strong>@T["Photos and copied ads"]</strong><span>@T["Real photos count; descriptions copied from other accounts don't."]</span></div>
                </li>
                <li class="sheet-row">
                    <span class="sheet-tick">@Icons.Svg("check")</span>
                    <div><strong>@T["Protected chat"]</strong><span>@T["We warn you if someone asks for money upfront or moves you to WhatsApp."]</span></div>
                </li>
            </ul>
            <div class="sheet-foot">
                <span>@T["Every ad gets a score from 0 to 100."]</span>
                @if (Model.RiskExample is { } risky)
                {
                    <a href="/l/@risky.Id">@T["See an ad we flagged"] (@risky.TrustScore/100)</a>
                }
            </div>
            <div class="stamp" aria-hidden="true">
                <div><div class="stamp-word">@T["CHECKED"]</div><div class="stamp-score">0–100</div><div class="stamp-sub">AICIGĂSEȘTI</div></div>
            </div>
        </aside>
    </div>
</section>

<div class="container">
    @await Component.InvokeAsync("Banner", new { placement = BannerPlacement.HomeTop })
</div>

<section class="container section-pad">
    <div class="section-head">
        <h2>@T["Categories"]</h2>
    </div>
    <div class="category-grid">
        @foreach (var cat in Model.RootCategories)
        {
            <a href="/c/@cat.Slug" class="category-tile">
                <span class="category-icon">@Icons.Category(cat.Slug)</span>
                <span class="category-name">@T[cat.Name]</span>
                <span class="category-sub">@T.Format("CountSubcategories", cat.Children.Count)</span>
            </a>
        }
    </div>
</section>

@if (Model.FeaturedListings.Count > 0)
{
    <section class="featured-band">
        <div class="container section-pad">
            <div class="section-head">
                <h2>@T["Featured ads"]</h2>
                <a href="/search" class="see-all">@T["See all"]@Icons.Svg("arrow", "icon-sm")</a>
            </div>
            <div class="listing-grid listing-grid-4">
                @foreach (var listing in Model.FeaturedListings)
                {
                    <partial name="_ListingCard" model="listing" />
                }
            </div>
        </div>
    </section>
}

<section class="container section-pad">
    <div class="section-head">
        <h2>@T["Latest ads"]</h2>
        <a href="/search?Sort=Newest" class="see-all">@T["See all"]@Icons.Svg("arrow", "icon-sm")</a>
    </div>
    @if (Model.LatestListings.Count > 0)
    {
        <div class="listing-grid listing-grid-4">
            @foreach (var listing in Model.LatestListings)
            {
                <partial name="_ListingCard" model="listing" />
            }
        </div>
    }
    else
    {
        <div class="empty-inline">
            <p>@T["No ads yet. Be the first to post one."]</p>
            <a href="/start" class="btn btn-primary">@Icons.Svg("plus")@T["Post ad"]</a>
        </div>
    }
</section>

@if (Model.PopularBrands.Count > 0)
{
    <section class="container section-pad">
        <div class="section-head">
            <h2>@T["Cars by brand"]</h2>
            <a href="/c/cars" class="see-all">@T["All cars"]@Icons.Svg("arrow", "icon-sm")</a>
        </div>
        <div class="brand-strip">
            @foreach (var brand in Model.PopularBrands)
            {
                <a href="/c/cars?BrandId=@brand.Id" class="brand-chip">@brand.Name</a>
            }
        </div>
    </section>
}

<section class="cta-band">
    <div class="container cta-inner">
        <div>
            <h2>@T["Already on OLX or Autovit?"]</h2>
            <p>@T["CtaImport"]</p>
        </div>
        <a href="/start" class="btn btn-light btn-lg">@Icons.Svg("link")@T["Bring my ad over"]</a>
    </div>
</section>

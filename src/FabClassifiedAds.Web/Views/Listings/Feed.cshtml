@model List<Listing>
@using System.Security.Claims
@{
    ViewData["Title"] = "Feed";
    Layout = "_Layout";
    var favoriteIds = ViewBag.FavoriteIds as HashSet<int> ?? [];
    var isAuthed = User.Identity?.IsAuthenticated == true;
}

<div class="feed-wrap">
    <div class="feed-scroller" id="feedScroller">
        @foreach (var l in Model)
        {
            var image = l.Images.FirstOrDefault();
            var isFav = favoriteIds.Contains(l.Id);
            <section class="feed-item" data-id="@l.Id">
                <div class="feed-media">
                    @if (!string.IsNullOrEmpty(l.VideoUrl))
                    {
                        <video src="@l.VideoUrl" muted loop playsinline preload="metadata"
                               poster="@(image?.Url ?? "/media/ph/aicigasesti.svg")" class="feed-video"></video>
                    }
                    else if (image != null)
                    {
                        <img src="@image.Url" alt="@l.Title" class="feed-kenburns" loading="lazy" />
                    }
                    else
                    {
                        <img src="/media/ph/aicigasesti.svg" alt="@T["No photo"]" loading="lazy" />
                    }
                    <div class="feed-shade"></div>
                </div>

                <div class="feed-info">
                    <div class="feed-cat">@T[l.Category.Name]</div>
                    <a href="/l/@l.Id" class="feed-title">@l.Title</a>
                    <div class="feed-summary">@l.ListingSummary()</div>
                    <div class="feed-price">@l.Price()</div>
                    <div class="feed-seller">
                        <span class="avatar avatar-sm">@(l.User.DisplayName.Length > 0 ? l.User.DisplayName[0] : '?')</span>
                        <span>@l.User.DisplayName</span>
                        <span class="muted">· @Icons.Svg("pin", "icon-sm") @l.City.Place()</span>
                    </div>
                </div>

                <div class="feed-rail">
                    @if (isAuthed)
                    {
                        <form action="/favorites/toggle/@l.Id" method="post" class="inline-form fav-form">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="rail-btn fav-btn @(isFav ? "is-fav" : "")" title="@T["Save to favorites"]" aria-label="@T["Save to favorites"]">@Icons.Svg("heart")</button>
                        </form>
                    }
                    else
                    {
                        <a href="/login?returnUrl=/feed" class="rail-btn" title="@T["Save to favorites"]" aria-label="@T["Save to favorites"]">@Icons.Svg("heart")</a>
                    }
                    <a href="/l/@l.Id" class="rail-btn" title="@T["Messages"]" aria-label="@T["Messages"]">@Icons.Svg("message")</a>
                    <button type="button" class="rail-btn feed-share" data-url="/l/@l.Id" data-title="@l.Title" title="@T["Share"]" aria-label="@T["Share"]"><span class="share-idle">@Icons.Svg("share")</span><span class="share-done" hidden>@Icons.Svg("check")</span></button>
                    <a href="/l/@l.Id/share-card.jpg" target="_blank" class="rail-btn" data-share-card data-title="@l.Title" data-filename="aicigasesti-@(l.Id).jpg" title="@T["Share card"]" aria-label="@T["Share card"]">@Icons.Svg("image")</a>
                    @if (!string.IsNullOrEmpty(l.VideoUrl))
                    {
                        <button type="button" class="rail-btn feed-mute" title="Audio" aria-label="Audio"><span class="mute-on">@Icons.Svg("volume-off")</span><span class="mute-off" hidden>@Icons.Svg("volume")</span></button>
                    }
                </div>
            </section>
        }
    </div>
    <div class="feed-hint">@T["Swipe or scroll"]</div>
</div>

@section Scripts {
    <script>
        // play/pause videos as they enter the viewport
        const videos = document.querySelectorAll('.feed-video');
        const observer = new IntersectionObserver(entries => {
            for (const entry of entries) {
                if (entry.isIntersecting && entry.intersectionRatio > 0.6) entry.target.play().catch(() => {});
                else entry.target.pause();
            }
        }, { threshold: [0, 0.6, 1] });
        videos.forEach(v => observer.observe(v));

        // mute toggle per item
        document.querySelectorAll('.feed-mute').forEach(btn => {
            btn.addEventListener('click', () => {
                const video = btn.closest('.feed-item').querySelector('.feed-video');
                video.muted = !video.muted;
                btn.querySelector('.mute-on').hidden = !video.muted;
                btn.querySelector('.mute-off').hidden = video.muted;
            });
        });

        // native share with clipboard fallback
        document.querySelectorAll('.feed-share').forEach(btn => {
            btn.addEventListener('click', async () => {
                const url = location.origin + btn.dataset.url;
                if (navigator.share) {
                    try { await navigator.share({ title: btn.dataset.title, url }); } catch {}
                } else {
                    await navigator.clipboard.writeText(url);
                    btn.querySelector('.share-idle').hidden = true;
                    btn.querySelector('.share-done').hidden = false;
                    setTimeout(() => {
                        btn.querySelector('.share-idle').hidden = false;
                        btn.querySelector('.share-done').hidden = true;
                    }, 1500);
                }
            });
        });

        // arrow-key navigation between items
        const scroller = document.getElementById('feedScroller');
        document.addEventListener('keydown', e => {
            if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
            e.preventDefault();
            scroller.scrollBy({ top: e.key === 'ArrowDown' ? scroller.clientHeight : -scroller.clientHeight, behavior: 'smooth' });
        });
    </script>
}

@model SearchPageViewModel
@{
    var f = Model.Filters;
    ViewData["Title"] = Model.CurrentCategory?.Name ?? (string.IsNullOrEmpty(f.Q) ? "Browse ads" : $"\"{f.Q}\"");
    ViewData["FavoriteIds"] = Model.FavoriteIds;
    var currentYear = DateTime.UtcNow.Year;
}

<div class="container search-page">
    <nav class="breadcrumb">
        <a href="/">Home</a>
        @foreach (var crumb in Model.Breadcrumb)
        {
            <span>›</span>
            <a href="/c/@crumb.Slug">@crumb.Name</a>
        }
    </nav>

    <div class="search-head">
        <h1>@(Model.CurrentCategory != null ? $"{Model.CurrentCategory.Icon} {Model.CurrentCategory.Name}" : (string.IsNullOrEmpty(f.Q) ? "All ads" : $"Results for “{f.Q}”"))</h1>
        <span class="result-count">@Model.Result.TotalCount.Number() ads</span>
    </div>

    @if (Model.ChildCategories.Count > 0)
    {
        <div class="subcat-strip">
            @foreach (var child in Model.ChildCategories)
            {
                <a href="/c/@child.Slug" class="subcat-chip">@child.Icon @child.Name</a>
            }
        </div>
    }

    <div class="search-layout">
        <aside class="filter-panel">
            <form method="get" action="@(Model.CurrentCategory != null ? $"/c/{Model.CurrentCategory.Slug}" : "/search")" id="filterForm">
                @if (Model.CurrentCategory == null && !string.IsNullOrEmpty(f.Category))
                {
                    <input type="hidden" name="Category" value="@f.Category" />
                }
                @if (!string.IsNullOrEmpty(f.Q))
                {
                    <input type="hidden" name="Q" value="@f.Q" />
                }

                <div class="filter-group">
                    <h3>Price (€)</h3>
                    <div class="range-row">
                        <input type="number" name="PriceMin" placeholder="From" value="@f.PriceMin" min="0" />
                        <input type="number" name="PriceMax" placeholder="To" value="@f.PriceMax" min="0" />
                    </div>
                </div>

                <div class="filter-group">
                    <h3>Location</h3>
                    <input type="text" name="City" placeholder="City or region" value="@f.City" />
                </div>

                @if (Model.ShowCarFilters)
                {
                    <div class="filter-group">
                        <h3>🚗 Brand & model</h3>
                        <select name="BrandId" id="brandSelect" data-models-url="/api/car-models/">
                            <option value="">Any brand</option>
                            <optgroup label="Popular brands">
                                @foreach (var brand in Model.Brands.Where(b => b.IsPopular))
                                {
                                    <option value="@brand.Id" selected="@(f.BrandId == brand.Id)">@brand.Name</option>
                                }
                            </optgroup>
                            <optgroup label="All brands">
                                @foreach (var brand in Model.Brands.Where(b => !b.IsPopular))
                                {
                                    <option value="@brand.Id" selected="@(f.BrandId == brand.Id)">@brand.Name</option>
                                }
                            </optgroup>
                        </select>
                        <select name="ModelId" id="modelSelect" class="mt-8">
                            <option value="">Any model</option>
                            @foreach (var carModel in Model.Models)
                            {
                                <option value="@carModel.Id" selected="@(f.ModelId == carModel.Id)">@carModel.Name</option>
                            }
                        </select>
                    </div>

                    <div class="filter-group">
                        <h3>Year</h3>
                        <div class="range-row">
                            <select name="YearMin"><option value="">From</option>
                                @for (var y = currentYear; y >= 1970; y--) { <option value="@y" selected="@(f.YearMin == y)">@y</option> }
                            </select>
                            <select name="YearMax"><option value="">To</option>
                                @for (var y = currentYear; y >= 1970; y--) { <option value="@y" selected="@(f.YearMax == y)">@y</option> }
                            </select>
                        </div>
                    </div>

                    <div class="filter-group">
                        <h3>Mileage (km)</h3>
                        <div class="range-row">
                            <input type="number" name="MileageMin" placeholder="From" value="@f.MileageMin" min="0" step="1000" />
                            <input type="number" name="MileageMax" placeholder="To" value="@f.MileageMax" min="0" step="1000" />
                        </div>
                    </div>

                    <div class="filter-group">
                        <h3>Fuel</h3>
                        <select name="Fuel">
                            <option value="">Any fuel</option>
                            @foreach (var fuel in Enum.GetValues<FuelType>())
                            {
                                <option value="@fuel" selected="@(f.Fuel == fuel)">@fuel.Humanize()</option>
                            }
                        </select>
                    </div>

                    <div class="filter-group">
                        <h3>Transmission & body</h3>
                        <select name="Transmission">
                            <option value="">Any transmission</option>
                            @foreach (var tr in Enum.GetValues<TransmissionType>())
                            {
                                <option value="@tr" selected="@(f.Transmission == tr)">@tr.Humanize()</option>
                            }
                        </select>
                        <select name="Body" class="mt-8">
                            <option value="">Any body type</option>
                            @foreach (var body in Enum.GetValues<BodyType>())
                            {
                                <option value="@body" selected="@(f.Body == body)">@body.Humanize()</option>
                            }
                        </select>
                        <select name="Drive" class="mt-8">
                            <option value="">Any drivetrain</option>
                            @foreach (var drive in Enum.GetValues<Drivetrain>())
                            {
                                <option value="@drive" selected="@(f.Drive == drive)">@drive.Humanize()</option>
                            }
                        </select>
                    </div>

                    <div class="filter-group">
                        <h3>Engine (cm³)</h3>
                        <div class="range-row">
                            <input type="number" name="EngineCcMin" placeholder="From" value="@f.EngineCcMin" min="0" step="100" />
                            <input type="number" name="EngineCcMax" placeholder="To" value="@f.EngineCcMax" min="0" step="100" />
                        </div>
                    </div>

                    <div class="filter-group">
                        <h3>Power (hp)</h3>
                        <div class="range-row">
                            <input type="number" name="PowerMin" placeholder="From" value="@f.PowerMin" min="0" step="10" />
                            <input type="number" name="PowerMax" placeholder="To" value="@f.PowerMax" min="0" step="10" />
                        </div>
                    </div>

                    <div class="filter-group">
                        <h3>More</h3>
                        <input type="text" name="Color" placeholder="Color" value="@f.Color" />
                        <select name="EmissionStandard" class="mt-8">
                            <option value="">Any emission standard</option>
                            @for (var e = 7; e >= 3; e--)
                            {
                                <option value="@e" selected="@(f.EmissionStandard == e)">Euro @e or newer</option>
                            }
                        </select>
                        <label class="check-row"><input type="checkbox" name="AccidentFreeOnly" value="true" checked="@f.AccidentFreeOnly" /> Accident-free only</label>
                        <label class="check-row"><input type="checkbox" name="ServiceBookOnly" value="true" checked="@f.ServiceBookOnly" /> With service book</label>
                    </div>

                    <div class="filter-group">
                        <h3>Equipment & options</h3>
                        <details class="options-details" open="@(f.Options.Count > 0)">
                            <summary>@(f.Options.Count > 0 ? $"{f.Options.Count} selected" : "Choose options")</summary>
                            <div class="options-list">
                                @foreach (var option in Enum.GetValues<CarOptions>().Where(o => o != CarOptions.None))
                                {
                                    <label class="check-row"><input type="checkbox" name="Options" value="@option" checked="@f.Options.Contains(option)" /> @option.Humanize()</label>
                                }
                            </div>
                        </details>
                    </div>
                }

                @if (Model.ShowRealEstateFilters)
                {
                    <div class="filter-group">
                        <h3>🏠 Property</h3>
                        <select name="PropertyType">
                            <option value="">Any property type</option>
                            @foreach (var pt in Enum.GetValues<PropertyType>())
                            {
                                <option value="@pt" selected="@(f.PropertyType == pt)">@pt.Humanize()</option>
                            }
                        </select>
                        <select name="Transaction" class="mt-8">
                            <option value="">Buy or rent</option>
                            @foreach (var tx in Enum.GetValues<TransactionType>())
                            {
                                <option value="@tx" selected="@(f.Transaction == tx)">@tx.Humanize()</option>
                            }
                        </select>
                    </div>

                    <div class="filter-group">
                        <h3>Rooms</h3>
                        <div class="range-row">
                            <select name="RoomsMin"><option value="">From</option>
                                @for (var r = 1; r <= 10; r++) { <option value="@r" selected="@(f.RoomsMin == r)">@r</option> }
                            </select>
                            <select name="RoomsMax"><option value="">To</option>
                                @for (var r = 1; r <= 10; r++) { <option value="@r" selected="@(f.RoomsMax == r)">@r</option> }
                            </select>
                        </div>
                    </div>

                    <div class="filter-group">
                        <h3>Surface (m²)</h3>
                        <div class="range-row">
                            <input type="number" name="SurfaceMin" placeholder="From" value="@f.SurfaceMin" min="0" />
                            <input type="number" name="SurfaceMax" placeholder="To" value="@f.SurfaceMax" min="0" />
                        </div>
                    </div>

                    <div class="filter-group">
                        <h3>Floor</h3>
                        <div class="range-row">
                            <input type="number" name="FloorMin" placeholder="From" value="@f.FloorMin" min="-1" />
                            <input type="number" name="FloorMax" placeholder="To" value="@f.FloorMax" min="-1" />
                        </div>
                    </div>

                    <div class="filter-group">
                        <h3>Year built</h3>
                        <div class="range-row">
                            <input type="number" name="YearBuiltMin" placeholder="From" value="@f.YearBuiltMin" min="1800" max="@currentYear" />
                            <input type="number" name="YearBuiltMax" placeholder="To" value="@f.YearBuiltMax" min="1800" max="@currentYear" />
                        </div>
                    </div>

                    <div class="filter-group">
                        <h3>Heating & furnishing</h3>
                        <select name="Heating">
                            <option value="">Any heating</option>
                            @foreach (var heat in Enum.GetValues<HeatingType>().Where(h => h != HeatingType.None))
                            {
                                <option value="@heat" selected="@(f.Heating == heat)">@heat.Humanize()</option>
                            }
                        </select>
                        <select name="Furnished" class="mt-8">
                            <option value="">Any furnishing</option>
                            @foreach (var furn in Enum.GetValues<FurnishedState>())
                            {
                                <option value="@furn" selected="@(f.Furnished == furn)">@furn.Humanize()</option>
                            }
                        </select>
                    </div>

                    <div class="filter-group">
                        <h3>Amenities</h3>
                        <details class="options-details" open="@(f.Amenities.Count > 0)">
                            <summary>@(f.Amenities.Count > 0 ? $"{f.Amenities.Count} selected" : "Choose amenities")</summary>
                            <div class="options-list">
                                @foreach (var amenity in Enum.GetValues<PropertyAmenities>().Where(a => a != PropertyAmenities.None))
                                {
                                    <label class="check-row"><input type="checkbox" name="Amenities" value="@amenity" checked="@f.Amenities.Contains(amenity)" /> @amenity.Humanize()</label>
                                }
                            </div>
                        </details>
                    </div>
                }

                <div class="filter-group">
                    <h3>Seller & condition</h3>
                    <select name="Seller">
                        <option value="">Any seller</option>
                        <option value="Private" selected="@(f.Seller == SellerType.Private)">Private</option>
                        <option value="Business" selected="@(f.Seller == SellerType.Business)">Business</option>
                    </select>
                    <select name="Condition" class="mt-8">
                        <option value="">Any condition</option>
                        @foreach (var cond in Enum.GetValues<ItemCondition>())
                        {
                            <option value="@cond" selected="@(f.Condition == cond)">@cond.Humanize()</option>
                        }
                    </select>
                    <label class="check-row"><input type="checkbox" name="NegotiableOnly" value="true" checked="@f.NegotiableOnly" /> Negotiable only</label>
                </div>

                <button type="submit" class="btn btn-primary btn-block">Apply filters</button>
                <a href="@(Model.CurrentCategory != null ? $"/c/{Model.CurrentCategory.Slug}" : "/search")" class="btn btn-ghost btn-block mt-8">Reset all</a>
            </form>
        </aside>

        <div class="search-results">
            <div class="sort-bar">
                <form method="get" action="@(Model.CurrentCategory != null ? $"/c/{Model.CurrentCategory.Slug}" : "/search")" id="sortForm">
                    @foreach (var (key, values) in Context.Request.Query.Where(kv => kv.Key != "Sort" && kv.Key != "Page" && kv.Key != "category"))
                    {
                        foreach (var value in values) { <input type="hidden" name="@key" value="@value" /> }
                    }
                    <label>Sort by
                        <select name="Sort" onchange="this.form.submit()">
                            <option value="Newest" selected="@(f.Sort == SortOption.Newest)">Newest first</option>
                            <option value="PriceAsc" selected="@(f.Sort == SortOption.PriceAsc)">Price: low → high</option>
                            <option value="PriceDesc" selected="@(f.Sort == SortOption.PriceDesc)">Price: high → low</option>
                            <option value="MostViewed" selected="@(f.Sort == SortOption.MostViewed)">Most viewed</option>
                            @if (Model.ShowCarFilters)
                            {
                                <option value="MileageAsc" selected="@(f.Sort == SortOption.MileageAsc)">Lowest mileage</option>
                                <option value="YearDesc" selected="@(f.Sort == SortOption.YearDesc)">Newest cars</option>
                            }
                            @if (Model.ShowRealEstateFilters)
                            {
                                <option value="SurfaceDesc" selected="@(f.Sort == SortOption.SurfaceDesc)">Largest surface</option>
                            }
                        </select>
                    </label>
                </form>
            </div>

            @if (Model.Result.Items.Count == 0)
            {
                <div class="empty-state">
                    <span class="empty-icon">🔭</span>
                    <h3>No ads match your filters</h3>
                    <p>Try widening the price range or removing some filters.</p>
                </div>
            }
            else
            {
                <div class="listing-grid">
                    @foreach (var listing in Model.Result.Items)
                    {
                        <partial name="_ListingCard" model="listing" />
                    }
                </div>

                @if (Model.Result.TotalPages > 1)
                {
                    <nav class="pagination">
                        @for (var p = 1; p <= Model.Result.TotalPages; p++)
                        {
                            var query = Context.Request.Query
                                .Where(kv => kv.Key != "Page" && kv.Key != "category")
                                .SelectMany(kv => kv.Value, (kv, v) => $"{Uri.EscapeDataString(kv.Key)}={Uri.EscapeDataString(v ?? "")}")
                                .Append($"Page={p}");
                            var href = $"{Context.Request.Path}?{string.Join("&", query)}";
                            <a href="@href" class="page-link @(p == Model.Result.Page ? "active" : "")">@p</a>
                        }
                    </nav>
                }
            }
        </div>
    </div>
</div>

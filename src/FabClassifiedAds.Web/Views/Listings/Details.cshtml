@model ListingDetailViewModel
@{
    var l = Model.Listing;
    ViewData["Title"] = l.SeoTitle();
    ViewData["MetaDescription"] = l.SeoDescription();
    var car = l.CarDetails;
    var re = l.RealEstateDetails;
    var canonical = $"{Context.Request.Scheme}://{Context.Request.Host}{l.SeoUrl()}";
    var ogImage = l.Images.FirstOrDefault()?.Url is { } img
        ? (img.StartsWith("http") ? img : $"{Context.Request.Scheme}://{Context.Request.Host}{img}")
        : $"{Context.Request.Scheme}://{Context.Request.Host}/l/{l.Id}/share-card.svg";
}

@section head {
    <link rel="canonical" href="@canonical" />
    <meta property="og:type" content="product" />
    <meta property="og:title" content="@l.SeoTitle()" />
    <meta property="og:description" content="@l.SeoDescription()" />
    <meta property="og:url" content="@canonical" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:site_name" content="AiciGăsești" />
    <meta name="twitter:card" content="summary_large_image" />
    @if (l.Price is not null)
    {
        <meta property="product:price:amount" content="@l.Price?.ToString(System.Globalization.CultureInfo.InvariantCulture)" />
        <meta property="product:price:currency" content="@l.Currency" />
    }
    <script type="application/ld+json">
    {
        "@@context": "https://schema.org",
        "@@type": "Product",
        "name": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(l.Title)),
        "description": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(l.SeoDescription())),
        "image": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(ogImage)),
        "offers": {
            "@@type": "Offer",
            "price": "@(l.Price?.ToString(System.Globalization.CultureInfo.InvariantCulture) ?? "0")",
            "priceCurrency": "@l.Currency",
            "availability": "https://schema.org/InStock"
        }
    }
    </script>
}

<div class="container detail-page">
    <nav class="breadcrumb">
        <a href="/">@T["Home"]</a>
        @foreach (var crumb in Model.Breadcrumb)
        {
            <span>›</span>
            <a href="/c/@crumb.Slug">@T[crumb.Name]</a>
        }
    </nav>

    <div class="detail-layout">
        <div class="detail-main">
            <div class="gallery">
                @if (!string.IsNullOrEmpty(l.VideoUrl))
                {
                    <div class="gallery-main gallery-video">
                        <video src="@l.VideoUrl" controls muted loop playsinline poster="@l.Images.FirstOrDefault()?.Url"></video>
                    </div>
                }
                else if (l.Images.Count > 0)
                {
                    <div class="gallery-main"><img src="@l.Images[0].Url" alt="@l.Title" id="galleryMain" /></div>
                    @if (l.Images.Count > 1)
                    {
                        <div class="gallery-thumbs">
                            @foreach (var image in l.Images)
                            {
                                <img src="@image.Url" alt="" class="gallery-thumb" onclick="document.getElementById('galleryMain').src=this.src" />
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="gallery-main card-media-empty">📷</div>
                }
            </div>

            <div class="panel">
                <div class="detail-title-row">
                    <div>
                        <h1>@l.Title</h1>
                        <div class="muted">@T["Posted"] @l.CreatedAt.TimeAgo() • 👁 @l.ViewCount.Number() @T["views"] • #@l.Id</div>
                    </div>
                    <div class="detail-price">@l.Price()
                        @if (l.IsNegotiable) { <span class="negotiable">@T["negotiable"]</span> }
                    </div>
                </div>

                @if (car != null)
                {
                    <h2 class="panel-subtitle">🚗 @T["Vehicle specifications"]</h2>
                    <dl class="spec-grid">
                        @if (car.Brand != null) { <div><dt>@T["Brand"]</dt><dd>@car.Brand.Name</dd></div> }
                        @if (car.Model != null) { <div><dt>@T["Model"]</dt><dd>@car.Model.Name</dd></div> }
                        @if (!string.IsNullOrEmpty(car.Variant)) { <div><dt>@T["Variant"]</dt><dd>@car.Variant</dd></div> }
                        <div><dt>@T["Year"]</dt><dd>@car.Year</dd></div>
                        <div><dt>@T["Mileage"]</dt><dd>@car.Mileage.Number() km</dd></div>
                        <div><dt>@T["Fuel"]</dt><dd>@car.Fuel.TranslateEnum()</dd></div>
                        <div><dt>@T["Transmission"]</dt><dd>@car.Transmission.TranslateEnum()</dd></div>
                        <div><dt>@T["Body"]</dt><dd>@car.Body.TranslateEnum()</dd></div>
                        <div><dt>@T["Drivetrain"]</dt><dd>@car.Drive.TranslateEnum()</dd></div>
                        @if (car.EngineCc.HasValue) { <div><dt>@T["Engine"]</dt><dd>@car.EngineCc cm³</dd></div> }
                        @if (car.PowerHp.HasValue) { <div><dt>@T["Power"]</dt><dd>@car.PowerHp @(FabClassifiedAds.Web.Services.Translator.IsRo ? "CP" : "hp")</dd></div> }
                        @if (car.BatteryKwh.HasValue) { <div><dt>@T["Battery"]</dt><dd>@car.BatteryKwh kWh</dd></div> }
                        @if (car.RangeKm.HasValue) { <div><dt>@T["Range"]</dt><dd>@car.RangeKm km</dd></div> }
                        @if (!string.IsNullOrEmpty(car.Color)) { <div><dt>@T["Color"]</dt><dd>@car.Color @(car.Metallic ? T["metallic"] : "")</dd></div> }
                        @if (car.Doors.HasValue) { <div><dt>@T["Doors"]</dt><dd>@car.Doors</dd></div> }
                        @if (car.EmissionStandard.HasValue) { <div><dt>@T["Emission"]</dt><dd>Euro @car.EmissionStandard</dd></div> }
                        @if (car.FuelConsumption.HasValue) { <div><dt>@T["Consumption"]</dt><dd>@car.FuelConsumption @(car.Fuel == FuelType.Electric ? "kWh" : "l")/100km</dd></div> }
                        <div><dt>@T["Owners"]</dt><dd>@car.OwnersCount</dd></div>
                        <div><dt>@T["Accident-free"]</dt><dd>@(car.AccidentFree ? $"✅ {T["Yes"]}" : T["No"])</dd></div>
                        <div><dt>@T["Service book"]</dt><dd>@(car.ServiceBook ? $"✅ {T["Yes"]}" : T["No"])</dd></div>
                    </dl>

                    @if (car.Options != CarOptions.None)
                    {
                        <h2 class="panel-subtitle">@T["Equipment"]</h2>
                        <div class="tag-cloud">
                            @foreach (var option in car.Options.Flags())
                            {
                                <span class="tag">✓ @option.TranslateEnum()</span>
                            }
                        </div>
                    }
                }

                @if (re != null)
                {
                    <h2 class="panel-subtitle">🏠 @T["Property details"]</h2>
                    <dl class="spec-grid">
                        <div><dt>@T["Type"]</dt><dd>@re.PropertyType.TranslateEnum()</dd></div>
                        <div><dt>@T["Transaction"]</dt><dd>@re.Transaction.TranslateEnum()</dd></div>
                        @if (re.Rooms.HasValue) { <div><dt>@T["Rooms"]</dt><dd>@re.Rooms</dd></div> }
                        @if (re.Bedrooms.HasValue) { <div><dt>@T["Bedrooms"]</dt><dd>@re.Bedrooms</dd></div> }
                        @if (re.Bathrooms.HasValue) { <div><dt>@T["Bathrooms"]</dt><dd>@re.Bathrooms</dd></div> }
                        <div><dt>@T["Surface"]</dt><dd>@re.SurfaceM2.ToString("0.#") m²</dd></div>
                        @if (re.LandSurfaceM2.HasValue) { <div><dt>@T["Land"]</dt><dd>@re.LandSurfaceM2?.ToString("0.#") m²</dd></div> }
                        @if (re.Floor.HasValue) { <div><dt>@T["Floor"]</dt><dd>@(re.Floor == 0 ? T["Ground"] : re.Floor.ToString())@(re.TotalFloors.HasValue ? $" / {re.TotalFloors}" : "")</dd></div> }
                        @if (re.YearBuilt.HasValue) { <div><dt>@T["Year built"]</dt><dd>@re.YearBuilt</dd></div> }
                        @if (re.Heating != HeatingType.None) { <div><dt>@T["Heating"]</dt><dd>@re.Heating.TranslateEnum()</dd></div> }
                        @if (re.EnergyClass != EnergyClass.Unknown) { <div><dt>@T["Energy class"]</dt><dd>@re.EnergyClass</dd></div> }
                        <div><dt>@T["Furnished"]</dt><dd>@re.Furnished.TranslateEnum()</dd></div>
                    </dl>

                    @if (re.Amenities != PropertyAmenities.None)
                    {
                        <h2 class="panel-subtitle">@T["Amenities"]</h2>
                        <div class="tag-cloud">
                            @foreach (var amenity in re.Amenities.Flags())
                            {
                                <span class="tag">✓ @amenity.TranslateEnum()</span>
                            }
                        </div>
                    }
                }

                <h2 class="panel-subtitle">@T["Description"]</h2>
                <p class="detail-description">@l.Description</p>

                @if (l.Attributes.Count > 0)
                {
                    <dl class="spec-grid">
                        @foreach (var attr in l.Attributes)
                        {
                            <div><dt>@attr.Key</dt><dd>@attr.Value</dd></div>
                        }
                    </dl>
                }
            </div>
        </div>

        <aside class="detail-side">
            @if (Model.Trust != null)
            {
                <div class="panel trust-panel @Model.Trust.CssClass">
                    <div class="trust-head">
                        <span class="trust-shield">🛡</span>
                        <div>
                            <h3>@T["AiciGăsești verification"]</h3>
                            <div class="trust-score-line">
                                <span class="trust-score">@Model.Trust.Score<small>/100</small></span>
                                <span class="trust-label">@T[TrustService.ListingScoreLabel(Model.Trust.Score)]</span>
                            </div>
                        </div>
                    </div>
                    @if (Model.Trust.Price is { } price)
                    {
                        <div class="trust-price trust-@price.Level.ToString().ToLowerInvariant()">
                            @(price.DiffPercent <= -30
                                ? T.Format("PriceBelowMarket", Math.Abs(price.DiffPercent), price.SampleSize)
                                : Math.Abs(price.DiffPercent) <= 25
                                    ? T.Format("PriceFair", price.SampleSize)
                                    : T.Format("PriceVsMarket", price.DiffPercent, price.SampleSize))
                        </div>
                    }
                    <ul class="trust-checks">
                        @foreach (var check in Model.Trust.Checks)
                        {
                            <li class="trust-@check.Level.ToString().ToLowerInvariant()">
                                <span>@(check.Level switch { TrustLevel.Good => "✓", TrustLevel.Info => "ℹ", TrustLevel.Warning => "⚠", _ => "✗" })</span>
                                @T[check.Label]@(check.Detail != null ? $" ({check.Detail})" : "")
                            </li>
                        }
                    </ul>
                    @if (Model.SellerTrust is { } st)
                    {
                        <div class="trust-divider"></div>
                        <div class="trust-score-line">
                            <span class="trust-chip @st.CssClass">🛡 @st.Score</span>
                            <span class="trust-label">@T[TrustService.ScoreLabel(st.Score)]</span>
                        </div>
                        <ul class="trust-checks mt-8">
                            @foreach (var check in st.Checks)
                            {
                                <li class="trust-@check.Level.ToString().ToLowerInvariant()">
                                    <span>@(check.Level switch { TrustLevel.Good => "✓", TrustLevel.Info => "ℹ", TrustLevel.Warning => "⚠", _ => "✗" })</span>
                                    @T[check.Label]@(check.Detail != null ? $" ({check.Detail})" : "")
                                </li>
                            }
                        </ul>
                    }
                </div>
            }

            @{
                var sellerUrl = $"/u/{l.UserId}/{FabClassifiedAds.Web.Data.CategorySeeder.Slugify(l.User.DisplayName)}";
            }
            <div class="panel seller-panel">
                <div class="seller-head">
                    <a href="@sellerUrl"><span class="avatar" style="background:@(l.User.AvatarColor ?? "#6d5dfc")">@(l.User.DisplayName.Length > 0 ? l.User.DisplayName[0] : '?')</span></a>
                    <div>
                        <a href="@sellerUrl" class="seller-name-link"><strong>@l.User.DisplayName</strong></a>
                        @if (l.User.IsBusiness) { <span class="badge badge-business">@T["Business"]</span> }
                        @if (Model.SellerTrust is { } sellerTrust)
                        {
                            <span class="trust-chip @sellerTrust.CssClass" title="@T[TrustService.ScoreLabel(sellerTrust.Score)]">🛡 @sellerTrust.Score</span>
                            <div class="small trust-seller-label @sellerTrust.CssClass-text">@T[TrustService.ScoreLabel(sellerTrust.Score)]</div>
                        }
                        <div class="muted small">@T["On AiciGăsești since"] @l.User.CreatedAt.ToString("MMM yyyy")</div>
                        @if (l.User.RatingCount > 0)
                        {
                            <div class="rating">★ @l.User.RatingAverage.ToString("0.0") <span class="muted small">(@l.User.RatingCount @T["reviews"])</span></div>
                        }
                    </div>
                </div>

                <div class="seller-location">📍 @l.City@(string.IsNullOrEmpty(l.Region) ? "" : $", {l.Region}")</div>
                @if (!string.IsNullOrWhiteSpace(l.ContactPhone))
                {
                    <a href="tel:@l.ContactPhone" class="btn btn-ghost btn-block mt-8">📞 @l.ContactPhone</a>
                }
                <a href="@sellerUrl" class="btn btn-ghost btn-sm btn-block mt-8">🏬 @T["See all seller's ads"]</a>

                @if (!Model.IsOwner)
                {
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <form action="/messages/start/@l.Id" method="post">
                            @Html.AntiForgeryToken()
                            <textarea name="body" rows="3" placeholder="@T["Hi! Is this still available?"]" required></textarea>
                            <button type="submit" class="btn btn-primary btn-block mt-8">💬 @T["Send message"]</button>
                        </form>
                        <form action="/favorites/toggle/@l.Id" method="post" class="mt-8">
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-ghost btn-block">@(Model.IsFavorite ? $"♥ {T["Saved — remove"]}" : $"♡ {T["Save to favorites"]}")</button>
                        </form>
                    }
                    else
                    {
                        <a href="/login?returnUrl=/l/@l.Id" class="btn btn-primary btn-block">@T["Sign in to contact seller"]</a>
                    }
                }
                else
                {
                    <div class="owner-note">@T["This is your ad."]</div>
                }
            </div>

            <div class="panel share-panel mt-16">
                <h3>↗ @T["Share"]</h3>
                <div class="share-actions">
                    <button type="button" class="btn btn-ghost btn-sm" id="shareBtn" data-title="@l.Title">↗ @T["Share link"]</button>
                    <a href="/l/@l.Id/share-card.svg" target="_blank" class="btn btn-ghost btn-sm">🖼 @T["Share card"]</a>
                </div>
                <p class="muted small">@T["Post the 9:16 card straight to TikTok or Instagram stories."]</p>
            </div>

            <div class="panel safety-panel">
                <h3>🛡️ @T["Stay safe"]</h3>
                <ul>
                    <li>@T["Meet in a public place"]</li>
                    <li>@T["Check the item before paying"]</li>
                    <li>@T["Never pay in advance to strangers"]</li>
                </ul>
            </div>
        </aside>
    </div>

    @section Scripts {
        <script>
            document.getElementById('shareBtn')?.addEventListener('click', async (e) => {
                const btn = e.currentTarget;
                if (navigator.share) {
                    try { await navigator.share({ title: btn.dataset.title, url: location.href }); } catch {}
                } else {
                    await navigator.clipboard.writeText(location.href);
                    btn.textContent = '✓ @T["Link copied"]';
                }
            });
        </script>
    }

    @if (Model.SimilarListings.Count > 0)
    {
        <section class="section-pad">
            <h2>@T["Similar ads"]</h2>
            <div class="listing-grid mt-16">
                @foreach (var similar in Model.SimilarListings)
                {
                    <partial name="_ListingCard" model="similar" />
                }
            </div>
        </section>
    }
</div>

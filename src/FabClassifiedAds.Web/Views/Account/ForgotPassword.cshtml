@model ForgotPasswordViewModel
@{
    ViewData["Title"] = T["Forgot your password?"];
}
<div class="container auth-page">
    <div class="panel auth-panel">
        <h1>@T["Forgot your password?"]</h1>
        @if (Model.Sent)
        {
            <div class="flash" role="status">@T["If an account exists for this address, we sent a link to choose a new password. Check your inbox and spam folder."]</div>
            <p class="auth-switch"><a href="/login">@T["Back to sign in"]</a></p>
        }
        else
        {
            <p class="muted">@T["Enter your account email and we'll send you a link to choose a new password."]</p>
            <form method="post" action="/forgot-password">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="All" class="validation-summary"></div>
                <label class="field"><span>@T["Email"]</span><input asp-for="Email" type="email" required autofocus autocomplete="email" /></label>
                <button type="submit" class="btn btn-primary btn-block">@T["Send reset link"]</button>
            </form>
            <p class="auth-switch"><a href="/login">@T["Back to sign in"]</a></p>
        }
    </div>
</div>

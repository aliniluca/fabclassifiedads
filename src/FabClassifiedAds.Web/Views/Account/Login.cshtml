@model LoginViewModel
@{
    ViewData["Title"] = T["Sign in"];
}
<div class="container auth-page">
    <div class="panel auth-panel">
        <h1>@T["Welcome back 👋"]</h1>
        <p class="muted">@T["Sign in to manage your ads, favorites and messages."]</p>
        <form method="post" action="/login">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="All" class="validation-summary"></div>
            <label class="field"><span>@T["Email"]</span><input asp-for="Email" type="email" required autofocus /></label>
            <label class="field"><span>@T["Password"]</span><input asp-for="Password" type="password" required /></label>
            <label class="check-row"><input asp-for="RememberMe" /> @T["Keep me signed in"]</label>
            <button type="submit" class="btn btn-primary btn-block">@T["Sign in"]</button>
        </form>
        <p class="auth-switch">@T["New here?"] <a href="/register">@T["Create an account"]</a></p>
        <p class="muted small">@T["Demo account:"] <code>alex@demo.fab</code> / <code>Demo123!</code></p>
    </div>
</div>

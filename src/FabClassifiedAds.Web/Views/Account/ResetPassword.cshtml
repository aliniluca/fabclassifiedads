@model ResetPasswordViewModel
@{
    ViewData["Title"] = T["Choose a new password"];
}
<div class="container auth-page">
    <div class="panel auth-panel">
        <h1>@T["Choose a new password"]</h1>
        <form method="post" action="/reset-password">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserId" />
            <input type="hidden" asp-for="Token" />
            <div asp-validation-summary="All" class="validation-summary"></div>
            <label class="field"><span>@T["New password"]</span><input asp-for="NewPassword" type="password" required minlength="6" autocomplete="new-password" autofocus /></label>
            <label class="field"><span>@T["Confirm password"]</span><input asp-for="ConfirmPassword" type="password" required autocomplete="new-password" /></label>
            <button type="submit" class="btn btn-primary btn-block">@T["Save new password"]</button>
        </form>
    </div>
</div>

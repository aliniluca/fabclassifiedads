@model List<Listing>
@{
    ViewData["Title"] = T["My ads"];
}
<div class="container section-pad">
    <div class="section-head">
        <h1>@T["My ads"]</h1>
        <a href="/post" class="btn btn-primary">@T["+ Post new ad"]</a>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon">📭</span>
            <h3>@T["You haven't posted anything yet"]</h3>
            <p><a href="/post">@T["Post your first ad"]</a> @T["— it takes under a minute."]</p>
        </div>
    }
    else
    {
        <div class="listing-grid">
            @foreach (var listing in Model)
            {
                <partial name="_ListingCard" model="listing" />
            }
        </div>
    }
</div>

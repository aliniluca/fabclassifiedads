@model List<Listing>
@{
    ViewData["Title"] = T["My ads"];
    ViewData["FavoriteIds"] = new HashSet<int>();
    var now = DateTime.UtcNow;
}
<div class="container section-pad">
    <div class="section-head">
        <h1>@T["My ads"]</h1>
        <div class="share-actions">
            <a href="/account/api" class="btn btn-ghost">🔑 @T["API key"]</a>
            <a href="/post" class="btn btn-primary">@T["+ Post new ad"]</a>
        </div>
    </div>
    @if (Model.Count == 0)
    {
        <div class="empty-state">
            <span class="empty-icon">📭</span>
            <h3>@T["You haven't posted anything yet"]</h3>
            <p><a href="/post">@T["Post your first ad"]</a> @T["— it takes under a minute."]</p>
        </div>
    }
    else
    {
        <div class="myads-list">
            @foreach (var l in Model)
            {
                var image = l.Images.FirstOrDefault();
                var daysLeft = l.ExpiresAt.HasValue ? (int)Math.Ceiling((l.ExpiresAt.Value - now).TotalDays) : (int?)null;
                var expiringSoon = l.Status == ListingStatus.Active && daysLeft is <= 5 and >= 0;
                <div class="myads-row panel">
                    <a href="/l/@l.Id" class="myads-thumb">
                        @if (image != null) { <img src="@image.Url" alt="" loading="lazy" /> } else { <span>📷</span> }
                    </a>
                    <div class="myads-main">
                        <a href="/l/@l.Id" class="myads-title">@l.Title</a>
                        <div class="muted small">@l.Category.Icon @T[l.Category.Name] · @l.Price() · 📍 @l.City</div>
                        <div class="myads-status">
                            @switch (l.Status)
                            {
                                case ListingStatus.Active:
                                    <span class="trust-chip trust-good">@T["Active"]</span>
                                    if (daysLeft is >= 0) { <span class="muted small">@T.Format("ExpiresInDays", daysLeft)</span> }
                                    break;
                                case ListingStatus.Expired:
                                    <span class="trust-chip trust-bad">@T["Expired"]</span>
                                    break;
                                case ListingStatus.PendingReview:
                                    <span class="trust-chip trust-warn">⏳ @T["In review"]</span>
                                    break;
                                case ListingStatus.Rejected:
                                    <span class="trust-chip trust-bad">🚫 @T["Rejected"]</span>
                                    break;
                                case ListingStatus.Sold:
                                    <span class="trust-chip">@T["Sold"]</span>
                                    break;
                                default:
                                    <span class="trust-chip">@l.Status.TranslateEnum()</span>
                                    break;
                            }
                        </div>
                    </div>
                    <div class="myads-actions">
                        @if (l.Status is ListingStatus.Expired or ListingStatus.Active)
                        {
                            <form method="post" action="/l/@l.Id/republish" class="inline-form">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn @(l.Status == ListingStatus.Expired || expiringSoon ? "btn-primary" : "btn-ghost") btn-sm">🔄 @T["Republish"]</button>
                            </form>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@{
    var active = ViewContext.RouteData.Values["action"]?.ToString();
}
<div class="admin-topnav">
    <a href="/admin" class="admin-topnav-link @(active == "Index" ? "active" : "")">@Icons.Svg("shield", "icon-sm") @T["Moderation"]</a>
    <a href="/admin/banners" class="admin-topnav-link @(active is "Banners" or "BannerCreate" or "BannerEdit" ? "active" : "")">@Icons.Svg("image", "icon-sm") @T["Banners"]</a>
    <a href="/admin/users" class="admin-topnav-link @(active == "Users" ? "active" : "")">@Icons.Svg("user", "icon-sm") @T["Users"]</a>
    <a href="/admin/settings" class="admin-topnav-link @(active == "Settings" ? "active" : "")">@Icons.Svg("settings", "icon-sm") @T["Settings"]</a>
</div>
